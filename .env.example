# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase.
# Si se dejan vacíos, la app funciona en "modo local" (datos solo en este navegador).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Respaldo en Google Drive: Client ID OAuth (tipo "Aplicación web") de Google Cloud.
VITE_GOOGLE_CLIENT_ID=
# Enlace "Código fuente" del pie de página (AGPL-3.0). Si publicas una versión modificada, apunta a tu repositorio.
VITE_URL_CODIGO=
